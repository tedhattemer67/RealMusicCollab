// ============================================================
// Music collaboration platform — schema
// Iteration 1: core entities — Project, Song, Track, Take.
// Iteration 2: roles — three-tier cascade (User.instanceRole, Membership,
//   SongRoleOverride), plus Approval and UnfreezeRequest.
//   No separate "Owner" permission — any Admin can manage accounts instance-wide.
// Iteration 2b: notifications — one-way webhook channels (Slack/Discord/generic),
//   no email dependency required.
// Iteration 2c: invites — shareable-link onboarding, no email dependency required.
// Iteration 3: annotations — comments on a Song, Track, Take, or Mix, timestamped or general.
// Iteration 4: mixes — Mix, MixComponent (the frozen per-track manifest),
//   Song.currentMixId; Approval and Annotation widened to also cover Mixes.
// Iteration 5: to-dos — Todo, scoped to Project/Song/Track, many-to-many assignment.
// Iteration 6: audit log — AuditLog, polymorphic (entityType, entityId) reference.
// All six planned iterations are now in place.
// Post-review pass: User.active/deactivatedAt added; StorageConfig introduced
//   (Take/Mix now reference it instead of a raw enum); AuditLog.action switched
//   from an enum to a plain String; added an index on AuditLog's polymorphic
//   reference.
// Iteration 7: sessions — User.passwordHash, Session (session-based auth,
//   not stateless JWT, so deactivation can revoke access immediately).
// ============================================================

datasource db {
  provider = "postgresql" // primary target: Render's managed Postgres
  url      = env("DATABASE_URL")
  // Pinned to Prisma 6 deliberately — Prisma 7 moved this url into a separate
  // prisma.config.ts file, but has an open, unresolved bug where migrate dev/deploy
  // fails to read it even when correctly set. See SETUP.md for details.
  // A MySQL variant of this file is used for Dreamhost testing — same models,
  // provider = "mysql" instead, plus setting the database to utf8mb4 before migrating.
}

generator client {
  provider = "prisma-client-js"
}

enum ProjectKind {
  SINGLE
  EP
  LP
  OTHER
}

enum SongStatus {
  DRAFT
  FROZEN
  PENDING_REAPPROVAL
}

enum StorageAdapter {
  GOOGLE_DRIVE
  S3
  LOCAL
}

// ============================================================
// Storage configuration
// Take/Mix used to carry a raw StorageAdapter enum directly, which couldn't
// tell two S3 buckets apart and had nowhere to put actual connection details
// (bucket name, region, folder id, local path root). A real StorageConfig
// row fixes that: Take/Mix now point at a specific configured instance, and
// a band can run more than one of the same adapter type if they ever need to.
// Null projectId = instance-wide default; set = this project uses its own.
// settings is intentionally a loose Json bag since each adapter type needs
// different fields (bucket+region for S3, folder id for Drive, a root path
// for local) — actual credentials belong in environment variables at
// runtime, not in this column, even though nothing here enforces that.
// ============================================================

model StorageConfig {
  id        String         @id @default(cuid())
  type      StorageAdapter
  label     String? // e.g. "Primary S3 bucket"
  projectId String?
  project   Project?       @relation(fields: [projectId], references: [id])
  isDefault Boolean        @default(false)
  settings  Json
  createdAt DateTime       @default(now())

  takes Take[]
  mixes Mix[]
}

// Minimal stub for now — email/auth fields arrive with the invite flow.
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  // Any Admin can deactivate an account instance-wide (no separate Owner tier).
  // Deactivated users are never deleted — history (Takes, Approvals, etc.)
  // must stay intact — just locked out of logging in.
  active        Boolean   @default(true)
  deactivatedAt DateTime?

  // Nullable rather than required: set when someone redeems an Invite and
  // picks a password. Existing seeded users have none yet, and it stays
  // nullable going forward too, in case a future auth method (SSO, etc.)
  // never needs a local password at all. Only ever a hash — never the
  // plaintext password itself.
  passwordHash String?

  // The three-tier role cascade, narrowest wins:
  //   SongRoleOverride (this song only) > Membership (this project only) > instanceRole (everywhere)
  // Most people just carry an instanceRole and never need a Membership or override at all —
  // those two only exist for the rare case where someone's access differs from their default.
  instanceRole Role

  uploadedTakes  Take[] @relation("UploadedBy")
  performedTakes Take[] @relation("PerformedBy")
  uploadedMixes  Mix[]  @relation("UploadedMix")

  memberships       Membership[]
  songRoleOverrides SongRoleOverride[]
  approvals         Approval[]
  unfreezeRequested UnfreezeRequest[] @relation("RequestedUnfreeze")
  unfreezeResolved  UnfreezeRequest[] @relation("ResolvedUnfreeze")
  createdInvites    Invite[]          @relation("CreatedInvites")
  usedInvites       Invite[]          @relation("UsedInvite")
  annotations       Annotation[]
  createdTodos      Todo[]            @relation("CreatedTodo")
  completedTodos    Todo[]            @relation("CompletedTodo")
  assignedTodos     Todo[]            @relation("TodoAssignees")
  auditLogs         AuditLog[]
  sessions          Session[]
}

model Project {
  id        String      @id @default(cuid())
  name      String
  caption   String?
  kind      ProjectKind @default(OTHER) // cosmetic label only — EP/LP/single, not structural
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Soft-hide only, no deletion — an Admin can pull a Project out of the
  // normal project list from the Manage Projects tab without touching any
  // of its Songs/Tracks/Takes or the files behind them.
  hidden    Boolean     @default(false)
  hiddenAt  DateTime?

  songs             Song[]
  memberships       Membership[]
  notificationChannels NotificationChannel[]
  invites           Invite[]
  todos             Todo[]
  storageConfigs    StorageConfig[]
}

model Song {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id])
  title     String
  status    SongStatus @default(DRAFT)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Mirrors Track.currentTakeId — same nullable-FK trick, same reason:
  // breaks the Song<->Mix insert cycle, never observably null in the UI.
  currentMixId String? @unique
  currentMix   Mix?    @relation("CurrentMix", fields: [currentMixId], references: [id])

  tracks            Track[]
  mixes             Mix[]
  songRoleOverrides SongRoleOverride[]
  unfreezeRequests  UnfreezeRequest[]
  annotations       Annotation[]
  todos             Todo[]
}

model Track {
  id            String   @id @default(cuid())
  songId        String
  song          Song     @relation(fields: [songId], references: [id])
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // The "current default" take. Nullable only to break the Track<->Take insert
  // cycle at the database level — the app must always create a Track and its
  // first Take in one transaction, so this is never observably null in the UI.
  currentTakeId String? @unique
  currentTake   Take?   @relation("CurrentTake", fields: [currentTakeId], references: [id])

  takes Take[] @relation("TrackTakes")
  annotations Annotation[]
  mixComponents MixComponent[]
  todos Todo[]
}

model Take {
  id         String         @id @default(cuid())
  trackId    String
  track      Track          @relation("TrackTakes", fields: [trackId], references: [id])
  takeNumber Int            // sequential per track, e.g. "Take 3" — set by app logic on create

  storageConfigId String
  storageConfig   StorageConfig @relation(fields: [storageConfigId], references: [id])
  storageKey      String        // path/key/id within that config's adapter

  performedById String         // required — guests get a Contributor account, never a plain-text name
  performedBy   User           @relation("PerformedBy", fields: [performedById], references: [id])
  uploadedById  String
  uploadedBy    User           @relation("UploadedBy", fields: [uploadedById], references: [id])

  note             String?     // optional take note, entered at upload time
  recordedOn       DateTime?   // session date, may differ from createdAt
  readyForFeedback Boolean     @default(true)

  createdAt DateTime @default(now())

  // Back-reference for the one-to-one "this take is the current default for its track"
  currentForTrack Track? @relation("CurrentTake")

  approvals Approval[]
  annotations Annotation[]
  mixComponents MixComponent[]

  @@unique([trackId, takeNumber])
}

// ============================================================
// Iteration 3: annotations
// A comment can attach to a Song, a Track, a Take, or a Mix — exactly one of
// the four. That "exactly one" rule isn't something Postgres or MySQL can both
// enforce portably via a single constraint, so it's enforced in application
// code instead. timestampSeconds is only meaningful when takeId is set (a
// point in that take's audio) — everything else just leaves it null.
// ============================================================

model Annotation {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation(fields: [authorId], references: [id])
  body     String @db.Text

  songId  String?
  song    Song?   @relation(fields: [songId], references: [id])
  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id])
  takeId  String?
  take    Take?   @relation(fields: [takeId], references: [id])
  mixId   String?
  mix     Mix?    @relation(fields: [mixId], references: [id])

  timestampSeconds Float? // only meaningful when takeId is set

  createdAt DateTime @default(now())
}

// ============================================================
// Iteration 2: roles, membership, and approvals
// ============================================================

enum Role {
  ADMIN
  CONTRIBUTOR
  REVIEWER
  VIEWER
}

// A per-project role that overrides a user's instanceRole for this project only.
// Only needed when this project's membership differs from someone's default.
model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, projectId])
}

// The narrowest, rarest override: a role for one specific song, taking precedence
// over both the project Membership and the instanceRole for this user on this song only.
model SongRoleOverride {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  songId    String
  song      Song     @relation(fields: [songId], references: [id])
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, songId])
}

// One person's sign-off on one specific Take or Mix — exactly one of the two,
// enforced in app code, same pattern as Annotation. Scoped to the specific Take
// (not the Track) so a fresh take starts with zero approvals, while an untouched
// take keeps the approvals it already had — this is what makes partial
// re-approval work. Same logic applies to a Mix versus its Song.
model Approval {
  id        String   @id @default(cuid())
  takeId    String?
  take      Take?    @relation(fields: [takeId], references: [id])
  mixId     String?
  mix       Mix?     @relation(fields: [mixId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([takeId, userId])
  @@unique([mixId, userId])
}

enum UnfreezeStatus {
  OPEN
  APPROVED
  DENIED
}

// Tracks a request to reopen a frozen song — whether explicit ("please unfreeze")
// or auto-created (a Contributor/Admin tried to add to a frozen song).
model UnfreezeRequest {
  id            String         @id @default(cuid())
  songId        String
  song          Song           @relation(fields: [songId], references: [id])
  requestedById String
  requestedBy   User           @relation("RequestedUnfreeze", fields: [requestedById], references: [id])
  reason        String?
  status        UnfreezeStatus @default(OPEN)
  resolvedById  String?
  resolvedBy    User?          @relation("ResolvedUnfreeze", fields: [resolvedById], references: [id])
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
}

// ============================================================
// Iteration 2b: notifications
// One-way outbound webhooks only (post a message out — no reading replies back).
// Covers Slack, Discord, Mattermost, or any tool that accepts an incoming webhook URL.
// This is deliberately not an OAuth "app" integration — no per-platform app review,
// no token refresh to manage, which matters a lot for self-hosted software where
// every band runs their own instance independently.
// ============================================================

enum NotificationChannelType {
  SLACK
  DISCORD
  GENERIC_WEBHOOK
}

model NotificationChannel {
  id         String                  @id @default(cuid())
  // Null = applies instance-wide (the common case for a single-band instance).
  // Set = this project posts to its own channel instead of the instance default.
  projectId  String?
  project    Project?                @relation(fields: [projectId], references: [id])
  type       NotificationChannelType
  webhookUrl String
  label      String?                 // e.g. "Band Discord #new-takes"
  createdAt  DateTime                @default(now())
}

// ============================================================
// Iteration 2c: invites
// A generated shareable link, not an email-triggered flow — an Admin creates one,
// pastes it wherever the band already talks, and whoever opens it and signs up
// gets the role attached to the invite. Sidesteps needing SMTP/email just to onboard.
// ============================================================

model Invite {
  id          String    @id @default(cuid())
  // The secret in the shareable URL. @default(cuid()) is a fallback only —
  // application code always supplies an explicit CSPRNG token
  // (crypto.randomBytes(32).toString('base64url')) on create; see the
  // Session model above for why cuid alone isn't enough for a bearer secret.
  token       String    @unique @default(cuid())
  // Null projectId = an instance-wide invite (grants an instanceRole).
  // Set projectId = scoped to one project (grants a Membership on that project).
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])
  role        Role
  createdById String
  createdBy   User      @relation("CreatedInvites", fields: [createdById], references: [id])
  expiresAt   DateTime?
  usedAt      DateTime?
  usedById    String?
  usedBy      User?     @relation("UsedInvite", fields: [usedById], references: [id])
  createdAt   DateTime  @default(now())
}

// ============================================================
// Iteration 4: mixes
// A Mix is a stereo version of a Song. It carries its own manifest
// (MixComponent) recording exactly which take of each track it was built
// from — that manifest never changes after creation, even if a track's
// current default take changes later, so an old mix stays meaningfully
// reproducible. Mixes go through the same annotate/approve lifecycle as a
// Take, and Song.currentMixId mirrors Track.currentTakeId.
//
// FINAL is permanent for a given Mix row — there's no unfreeze-equivalent
// that reopens it. Redoing a finished mix means creating a brand-new Mix
// (the next mixNumber), not reverting this one back to DRAFT.
//
// MixComponent doesn't require covering every Track in the Song — a mix can
// be built before every part exists yet (e.g. before a tambourine track has
// been added), so a missing MixComponent row for a track just means that
// track wasn't part of this particular mix.
// ============================================================

enum MixStatus {
  DRAFT
  FINAL // permanent for this row — redoing a mix means a new Mix (next mixNumber), not reverting this one
}

model Mix {
  id        String @id @default(cuid())
  songId    String
  song      Song   @relation(fields: [songId], references: [id])
  mixNumber Int    // sequential per song, e.g. "Mix v2" — set by app logic on create

  storageConfigId String
  storageConfig   StorageConfig @relation(fields: [storageConfigId], references: [id])
  storageKey      String

  uploadedById String
  uploadedBy   User   @relation("UploadedMix", fields: [uploadedById], references: [id])

  status MixStatus @default(DRAFT)

  createdAt DateTime @default(now())

  components  MixComponent[]
  approvals   Approval[]
  annotations Annotation[]

  // Back-reference for the one-to-one "this mix is the current one for its song"
  currentForSong Song? @relation("CurrentMix")

  @@unique([songId, mixNumber])
}

// The manifest: one row per track this mix pulled from, pointing at the exact
// take used — frozen at creation time, never updated afterward.
model MixComponent {
  id      String @id @default(cuid())
  mixId   String
  mix     Mix    @relation(fields: [mixId], references: [id])
  trackId String
  track   Track  @relation(fields: [trackId], references: [id])
  takeId  String
  take    Take   @relation(fields: [takeId], references: [id])

  @@unique([mixId, trackId])
}

// ============================================================
// Iteration 5: to-dos
// Scoped to exactly one of Project, Song, or Track (same "exactly one parent,
// enforced in app code" pattern as Annotation) — not Take or Mix level.
// Assignment is many-to-many: a to-do can be unassigned, assigned to one
// person, or assigned to several. completedAt/completedBy are denormalized
// onto the row itself (not left to AuditLog alone) so the UI can show "done
// by Jamie on Jul 24" without an extra join.
// ============================================================

model Todo {
  id   String @id @default(cuid())
  body String

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  songId    String?
  song      Song?    @relation(fields: [songId], references: [id])
  trackId   String?
  track     Track?   @relation(fields: [trackId], references: [id])

  deadline DateTime?

  completed     Boolean   @default(false)
  completedAt   DateTime?
  completedById String?
  completedBy   User?     @relation("CompletedTodo", fields: [completedById], references: [id])

  createdById String
  createdBy   User     @relation("CreatedTodo", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  assignees User[] @relation("TodoAssignees")
}

// ============================================================
// Iteration 6: audit log
// Deliberately a different pattern than Annotation/Todo: rather than a fixed
// set of nullable foreign keys (one per possible parent), this uses a
// polymorphic (entityType, entityId) pair so logging a new kind of event
// later never requires a schema migration. The real tradeoff: the database
// cannot enforce that entityId points at an actual row of that type — that
// referential integrity is given up on purpose for this one table, since an
// audit log is a historical record, not a live relationship.
// metadata holds action-specific context (e.g. which download mode was used,
// which take got promoted) without needing a column per action type.
// ============================================================

// Deliberately a plain String, not an enum — an enum here would quietly
// contradict the whole point of the polymorphic entityType/entityId design:
// logging a genuinely new kind of event should never require a migration.
// Conventional values in use so far (kept here as documentation, not
// database-enforced):
//   SONG_FROZEN, UNFREEZE_REQUESTED, UNFREEZE_APPROVED, UNFREEZE_DENIED,
//   TAKE_UPLOADED, TAKE_PROMOTED, APPROVAL_GIVEN, MIX_CREATED, MIX_FINALIZED,
//   DOWNLOAD_WORKING_PULL, DOWNLOAD_HANDOFF, DOWNLOAD_ARCHIVE,
//   TODO_CREATED, TODO_COMPLETED
model AuditLog {
  id     String @id @default(cuid())
  action String

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])

  entityType String // e.g. "Song", "Take", "Mix", "Todo" — not a DB-enforced FK
  entityId   String // the id of that row — no referential integrity, by design

  metadata Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

// ============================================================
// Iteration 7: sessions
// One row per logged-in session, not a stateless JWT — deliberately, so a
// deactivated user's access can be cut off immediately by revoking their
// sessions, rather than waiting for a token to expire on its own. The
// session's own id is what gets stored in the browser cookie; there's no
// separate token field. The @default(cuid()) below is a fallback only —
// application code always supplies an explicit CSPRNG id
// (crypto.randomBytes(32).toString('base64url')) on create, since cuid is
// optimized for uniqueness/collision-avoidance, not unguessability, and
// this id doubles as a bearer credential.
// ============================================================

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime? // set on logout, or when an Admin deactivates this user

  @@index([userId])
}
